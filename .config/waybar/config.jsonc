{
  "layer": "top",
  "position": "top",

  "height": 41,
  "margin-top": 7,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "cpu",
    "memory"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "clock",
    "tray"
  ],

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    },

    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",

    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },

    "tooltip-format": "Volume: {volume}%",

    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",

    "tooltip-format": "{status}",
    "on-click": "blueman-manager"
  },

  "clock": {
    "format": "󰥔  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
