@import "colors"

* {
    font: "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 620px;

    background-color: @bg;

    border: 2px;
    border-color: @border;
    border-radius: 22px;

    padding: 18px;
}

mainbox {
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    background-color: @bg-alt;

    border-radius: 15px;

    padding: 12px 16px;
    spacing: 10px;

    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
}

entry {
    background-color: transparent;
    text-color: @fg;

    placeholder: "Search...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: transparent;

    lines: 7;
    columns: 1;

    fixed-height: false;
    scrollbar: false;

    spacing: 6px;
}

element {
    background-color: transparent;
    text-color: @fg;

    border-radius: 13px;

    padding: 10px 12px;
    spacing: 12px;

    children: [ element-icon, element-text ];
}

element selected {
    background-color: @accent;
    text-color: @accent-fg;
}

element-icon {
    background-color: transparent;

    size: 28px;

    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;
}

message {
    background-color: @bg-alt;

    border-radius: 13px;

    padding: 10px;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}
