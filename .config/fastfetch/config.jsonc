{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "nixos"
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    "title",

    {
      "type": "custom",
      "format": "──────────────────────────"
    },

    {
      "type": "os",
      "key": "  OS"
    },

    {
      "type": "kernel",
      "key": "  Kernel"
    },

    {
      "type": "uptime",
      "key": "󰔚  Uptime"
    },

    {
      "type": "packages",
      "key": "󰏖  Packages"
    },

    {
      "type": "shell",
      "key": "  Shell"
    },

    {
      "type": "display",
      "key": "󰍹  Display"
    },

    {
      "type": "wm",
      "key": "  WM"
    },

    {
      "type": "terminal",
      "key": "  Terminal"
    },

    {
      "type": "terminalfont",
      "key": "  Font"
    },

    {
      "type": "cpu",
      "key": "  CPU"
    },

    {
      "type": "gpu",
      "key": "󰢮  GPU"
    },

    {
      "type": "memory",
      "key": "  Memory"
    },

    {
      "type": "disk",
      "key": "󰋊  Disk"
    },

    "break",

    "colors"
  ]
}
